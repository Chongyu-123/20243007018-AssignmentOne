<?xml version="1.0" encoding="utf-8"?>
<!-- Part B: proportions, rather than fixed dimensions, adapt the home screen to its window. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Equal weights give the banner and the service grid half of the usable height each. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Crop the decorative photograph proportionally instead of stretching it. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <!-- The specification permits 40sp for this title; other dimensions remain flexible. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/welcome_message"
            android:textColor="@android:color/white"
            android:textSize="40sp" />
    </FrameLayout>

    <!-- Weighted spacers provide gutters that also grow or shrink with the screen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.08" />
        <!-- Each horizontal row has two equally weighted service cells. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.08" />
            <!-- Facilities: the image grows with available space; its label wraps naturally. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_facilities"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_background"
                    android:contentDescription="@string/facilities"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_facilities" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/facilities"
                    android:textColor="@android:color/black" />

            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.08" />
            <!-- Events: the image grows with available space; its label wraps naturally. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_events"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_background"
                    android:contentDescription="@string/events"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_events" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/events"
                    android:textColor="@android:color/black" />

            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.08" />
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.08" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.08" />
            <!-- Clubs: the image grows with available space; its label wraps naturally. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_clubs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_background"
                    android:contentDescription="@string/clubs"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_clubs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/clubs"
                    android:textColor="@android:color/black" />

            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.08" />
            <!-- Support: the image grows with available space; its label wraps naturally. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_support"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_background"
                    android:contentDescription="@string/support"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_support" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/support"
                    android:textColor="@android:color/black" />

            </LinearLayout>
            <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.08" />
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.08" />
    </LinearLayout>
</LinearLayout>
